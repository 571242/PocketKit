<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Core personal file-manager feature: user-selected export of installed base/split APKs, including apps without launchers. No inventory leaves the device. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <!-- Not a grantable permission: declaring it only makes PocketKit appear in
         Developer options -> Select mock location app. Real authority is the app op. -->
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION" tools:ignore="MockLocation,ProtectedPermissions" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <package android:name="com.tencent.mobileqq" />
    </queries>
    <application android:label="拾用" android:theme="@style/AppTheme" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true" android:requestLegacyExternalStorage="true" android:usesCleartextTraffic="true" android:icon="@mipmap/ic_pocketkit" android:roundIcon="@mipmap/ic_pocketkit">
        <!-- Initialize ML Kit only when a model tool is used, never before the launcher. -->
        <provider android:name="com.google.mlkit.common.internal.MlKitInitProvider" tools:node="remove" />
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".ReaderActivity" android:label="拾用·轻量阅读" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
            </intent-filter>
        </activity>
        <activity android:name=".PinImageActivity" android:label="拾用·贴屏参考图" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <service android:name=".pinoverlay.PinOverlayService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started pinned image overlay for visual reference; closed from its controls or notification. No screen recording." />
        </service>
        <activity android:name=".BrowserHomeActivity" android:label="拾用·无痕浏览" android:exported="false"
            android:launchMode="singleTop" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".PrivateBrowserActivity" android:label="拾用·无痕浏览"
            android:exported="false" android:process=":private_browser"
            android:launchMode="singleTask" android:taskAffinity="cn.xianhua.pocketkit.private_browser"
            android:excludeFromRecents="true" android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".PatchEditorActivity" android:label="拾用·图片修字" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />
        <activity android:name=".LanShareActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <service android:name=".lanshare.LanShareService" android:exported="false" android:foregroundServiceType="dataSync" />
        <activity android:name=".MockLocationActivity" android:label="拾用·模拟定位" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".FileToolsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ArchiveActivity" android:label="拾用·压缩解压" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/x-rar-compressed" />
            </intent-filter>
        </activity>
        <receiver android:name=".timer.TimerAlarmReceiver" android:exported="false">
            <intent-filter><action android:name="cn.xianhua.pocketkit.timer.FIRE" /></intent-filter>
        </receiver>
        <activity android:name=".LocalToolsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MediaToolsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".VoiceToolsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".AiVoiceToolsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".VoiceOverlayActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <service android:name=".voiceoverlay.VoiceOverlayService" android:exported="false" android:foregroundServiceType="microphone|mediaPlayback" />
        <activity android:name=".AdSkipToolsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".DeviceToolsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".RangefinderActivity" android:label="拾用·相机测距" android:exported="false" />
        <activity android:name=".AutomationToolsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".proxy.ProxyActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <service android:name=".proxy.PocketVpnService"
            android:icon="@mipmap/ic_pocketkit"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started local rule proxy and VPN service; stopped explicitly by the user from notification or UI." />
        </service>
        <!-- The manager itself is not a viewer: this activity only receives shares, so it never
             claims file types it cannot display. Locating a file from another app's "open with"
             list goes through the separately labelled alias below. -->
        <activity android:name=".ManagerActivity" android:label="拾用管理器" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" /><action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" /><data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- Locate-only entry, offered for every file type: jumps to the real parent folder of the
             file it was handed, highlights it, and does nothing else. The Chinese label keeps it
             honest inside the chooser; it declares no android:priority and no BROWSABLE category,
             so it is one more option in "open with" and never installs itself as the preferred
             handler. It never copies a file to fake a location and requests no extra permission. -->
        <activity-alias android:name=".ManagerLocateActivity" android:targetActivity=".ManagerActivity"
            android:label="拾用·定位文件位置" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="*/*" />
                <data android:scheme="file" android:mimeType="*/*" />
            </intent-filter>
            <!-- Senders that call setData without a MIME type fail the typed filter above, so the
                 same entry also answers plain scheme intents. Still no priority, still VIEW only. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
        </activity-alias>
        <provider android:name=".ManagerShareProvider" android:authorities="${applicationId}.manager.share" android:exported="false" android:grantUriPermissions="true" />
        <activity android:name=".AboutActivity" android:exported="false" />
        <service android:name=".device.TicketTapService" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true" android:label="@string/ticket_accessibility_label">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/ticket_accessibility" />
        </service>
        <service android:name=".device.TicketRecorderService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started overlay editor for selecting and saving click positions, explicitly stopped when recording is saved or cancelled." />
        </service>
        <service android:name=".device.TicketOverlayService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started floating countdown clock and vibration reminders while switching to another app; stopped explicitly or shortly after the target time." />
        </service>
        <service android:name=".automation.AutomationOverlayService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started automation control overlay with pause, resume and emergency stop; never hidden from the user." />
        </service>
        <service android:name=".automation.AutomationPickerService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started automation point, swipe, template and region picker; stopped when the selection is saved or cancelled." />
        </service>
        <service android:name=".automation.AutomationRecorderService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started single-finger gesture recording with a visible floating pause, undo, save and cancel controller. Gestures are replayed only following the user's touch; recording ends explicitly." />
        </service>
        <service android:name=".automation.ProjectionCaptureService" android:exported="false" android:foregroundServiceType="mediaProjection" />
        <service android:name=".mocklocation.MockLocationService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started mock location feed: keeps a visible notification with pause, speed and stop while the user checks other apps' location; stopped explicitly and test providers are always removed on exit." />
        </service>
    </application>
</manifest>